# ===========================================
# 7TY.VN - Environment Configuration
# ===========================================
# Copy this file to .env and update values

# Database Configuration
# ----------------------
# Option 1: PostgreSQL (Recommended for production)
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=7ty_admin
DB_PASSWORD=your-secure-password
DB_NAME=7ty_vn_db

# Option 2: SQLite (For development/small deployments)
# DATABASE_TYPE=sqlite
# SQLITE_DB_PATH=./7ty_vn.db

# JWT & Security
# --------------
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_HOURS=24

# Application Settings
# --------------------
APP_NAME=7TY.VN
APP_VERSION=4.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Settings
# -------------
# For production, specify exact origins
# CORS_ORIGINS=["https://yourdomain.com"]

# Email (Optional - for notifications)
# ------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@7ty.vn

# ===========================================
# PLATFORM-SPECIFIC SETTINGS
# ===========================================

# Railway.app
# -----------
# DATABASE_TYPE=postgres
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# DB_NAME=${{Postgres.PGDATABASE}}

# Render.com
# ----------
# DATABASE_TYPE=postgres
# DB_HOST=<from render postgres dashboard>
# DB_PORT=5432
# DB_USER=7ty_admin
# DB_PASSWORD=<from render postgres dashboard>
# DB_NAME=7ty_vn_db

# Fly.io
# ------
# DATABASE_URL will be set automatically when you attach postgres
# DATABASE_TYPE=postgres

