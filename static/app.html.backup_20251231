        // Generate mock chart data for demo
        function generateMockChartData(period) {
            const labels = [];
            const values = [];
            let days = 7;
            
            switch(period) {
                case 'week': days = 7; break;
                case 'month': days = 30; break;
                case 'quarter': days = 90; break;
                case 'year': days = 12; break;
            }
            
            if (period === 'year') {
                const months = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'];
                for (let i = 0; i < 12; i++) {
                    labels.push(months[i]);
                    values.push(Math.floor(Math.random() * 50000000) + 10000000);
                }
            } else {
                for (let i = days - 1; i >= 0; i--) {
                    const date = new Date();
                    date.setDate(date.getDate() - i);
                    labels.push(date.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }));
                    values.push(Math.floor(Math.random() * 10000000) + 1000000);
                }
            }
            
            return {
                sales_data: { labels, values },
                bills_data: {
                    labels: ['Trong kho', 'Đã bán', 'Đã thanh toán', 'Chờ xử lý'],
                    values: [
                        Math.floor(Math.random() * 100) + 50,
                        Math.floor(Math.random() * 200) + 100,
                        Math.floor(Math.random() * 150) + 80,
                        Math.floor(Math.random() * 50) + 10
                    ]
                }
            };
        }

