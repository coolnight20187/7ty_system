                }
                
                hideLoading();
                clearSelectedBills();
                
                // Reload bills
                const activeTab = document.querySelector('[data-bill-tab].active');
                const status = activeTab?.dataset.billTab || 'in_stock';
                loadBills(status, 1);
                
                if (failCount > 0) {
                    showToast(`Đã xóa ${successCount}/${selectedBillIds.length} hóa đơn`, 'warning');
                } else {
                    showToast(`Đã xóa ${successCount} hóa đơn thành công`, 'success');
