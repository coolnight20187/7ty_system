<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>7TY.VN - Hệ Thống Quản Trị Đại Lý Thu Hộ</title>
    
    <!-- Meta tags for SEO and PWA -->
    <meta name="description" content="Hệ thống quản lý đại lý thu hộ điện với API tích hợp đầy đủ">
    <meta name="theme-color" content="#0d4a4a">
    <link rel="manifest" href="/static/manifest.json">
    
    <!-- CSS Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" rel="stylesheet">
    
    <!-- App CSS -->
    <style>
        :root {
            /* Dark Teal - Xanh Ngọc đậm (từ logo) */
            --primary-color: #0d4a4a;
            --primary-dark: #0a3d3d;
            --primary-light: #14605f;
            /* Metallic Gold - Vàng kim loại (từ logo) */
            --secondary-color: #c9a227;
            --gold-color: #c9a227;
            --gold-light: #d4af37;
            --gold-dark: #b8960f;
            /* Status colors */
            --success-color: #14919b;
            --danger-color: #c0392b;
            --warning-color: #c9a227;
            --info-color: #0d4a4a;
            /* Neutral colors */
            --dark-color: #1a1a2e;
            --light-color: #f8f9fa;
            --sidebar-width: 260px;
            --header-height: 75px;
            --border-radius: 16px;
            --border-radius-lg: 24px;
            --box-shadow: 0 8px 32px rgba(13, 74, 74, 0.12);
            --box-shadow-lg: 0 20px 60px rgba(13, 74, 74, 0.15);
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            /* Glassmorphism */
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(255, 255, 255, 0.18);
            --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #f5f7fb 0%, #e8f4f4 50%, #f0f5f5 100%);
            background-attachment: fixed;
            color: #2d3748;
            overflow-x: hidden;
            font-size: 14px;
            transition: var(--transition);
            line-height: 1.6;
        }

        /* Luxury scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        
        ::-webkit-scrollbar-track {
            background: rgba(13, 74, 74, 0.05);
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #0d4a4a 0%, #c9a227 100%);
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #0a3d3d 0%, #d4af37 100%);
        }

        /* Loading Screen - Luxury */
        #loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #0a3d3d 0%, #0d4a4a 40%, #0f5252 70%, #0a3d3d 100%);
            background-size: 400% 400%;
            animation: gradientShift 8s ease infinite;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }
        
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .loading-spinner {
            width: 70px;
            height: 70px;
            border: 3px solid rgba(201, 162, 39, 0.2);
            border-top: 3px solid #c9a227;
            border-right: 3px solid #d4af37;
            border-radius: 50%;
            animation: spin 1s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
            margin-bottom: 25px;
            box-shadow: 0 0 30px rgba(201, 162, 39, 0.3);
        }

        .loading-text {
            color: white;
            font-size: 20px;
            font-weight: 300;
            letter-spacing: 3px;
            text-transform: uppercase;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Sidebar - Luxury */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0a3d3d 0%, #0d4a4a 30%, #0f5252 70%, #0d4a4a 100%);
            color: white;
            z-index: 1000;
            overflow-y: auto;
            transition: var(--transition);
            box-shadow: 5px 0 40px rgba(13, 74, 74, 0.5), inset -1px 0 0 rgba(201, 162, 39, 0.1);
        }
        
        .sidebar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 200px;
            background: linear-gradient(180deg, rgba(201, 162, 39, 0.1) 0%, transparent 100%);
            pointer-events: none;
        }

        .sidebar-header {
            padding: 30px 25px;
            border-bottom: 1px solid rgba(201, 162, 39, 0.2);
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
        }

        .logo {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #c9a227 0%, #d4af37 50%, #e8c547 75%, #c9a227 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0a3d3d;
            font-size: 22px;
            font-weight: bold;
            box-shadow: 0 8px 25px rgba(201, 162, 39, 0.5), inset 0 1px 0 rgba(255,255,255,0.3);
            animation: logoShine 3s ease-in-out infinite;
        }
        
        @keyframes logoShine {\n            0%, 100% { box-shadow: 0 8px 25px rgba(201, 162, 39, 0.5); }
            50% { box-shadow: 0 8px 35px rgba(201, 162, 39, 0.7), 0 0 20px rgba(201, 162, 39, 0.3); }
        }

        .system-name h3 {
            font-size: 20px;
            margin: 0;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .system-name span {
            font-size: 11px;
            opacity: 0.8;
        }

        .sidebar-menu {
            padding: 25px 0;
        }

        .menu-item {
            padding: 14px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            transition: var(--transition);
            position: relative;
            font-weight: 500;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            margin: 2px 0;
        }

        .menu-item:hover {
            background: linear-gradient(90deg, rgba(201, 162, 39, 0.15) 0%, rgba(255,255,255,0.05) 100%);
            color: white;
            padding-left: 30px;
        }
        
        .menu-item.active {
            background: linear-gradient(90deg, rgba(201, 162, 39, 0.2) 0%, rgba(255,255,255,0.08) 100%);
            color: #d4af37;
        }

        .menu-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient(180deg, #c9a227 0%, #d4af37 50%, #c9a227 100%);
            box-shadow: 0 0 15px rgba(201, 162, 39, 0.5);
        }

        .menu-item i {
            width: 22px;
            text-align: center;
            font-size: 17px;
            transition: var(--transition);
        }
        
        .menu-item:hover i {
            color: #c9a227;
            transform: scale(1.1);
        }
        
        .menu-item.active i {
            color: #c9a227;
        }

        .menu-badge {
            margin-left: auto;
            background: linear-gradient(135deg, #c9a227 0%, #d4af37 100%);
            color: #0a3d3d;
            font-size: 10px;
            padding: 3px 10px;
            border-radius: 12px;
            min-width: 22px;
            text-align: center;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(201, 162, 39, 0.4);
        }

        .submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0,0,0,0.1);
        }

        .submenu.show {
            max-height: 500px;
        }

        .submenu-item {
            padding: 10px 25px 10px 60px;
            display: block;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 13px;
            transition: var(--transition);
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
        }

        .submenu-item:hover, .submenu-item.active {
            color: white;
            background: rgba(255,255,255,0.05);
        }

        .sidebar-footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 20px;
            border-top: 1px solid rgba(201, 162, 39, 0.15);
            text-align: center;
            font-size: 11px;
            opacity: 0.6;
            letter-spacing: 1px;
            background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.2) 100%);
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            transition: var(--transition);
            position: relative;
        }
        
        .main-content::before {
            content: '';
            position: fixed;
            top: -50%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(201, 162, 39, 0.03) 0%, transparent 70%);
            pointer-events: none;
            z-index: -1;
        }

        /* Header - Glassmorphism */
        .header {
            height: var(--header-height);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(201, 162, 39, 0.1);
            padding: 0 35px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 30px rgba(13, 74, 74, 0.08);
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--primary-color);
            font-size: 22px;
            cursor: pointer;
            transition: var(--transition);
        }
        
        .sidebar-toggle:hover {
            color: var(--gold-color);
            transform: scale(1.1);
        }

        .page-title h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0;
            color: var(--primary-dark);
            letter-spacing: -0.5px;
        }

        .page-title .breadcrumb {
            list-style: none;
            padding: 0;
            margin: 6px 0 0;
            display: flex;
            gap: 10px;
            font-size: 13px;
            color: #718096;
        }

        .page-title .breadcrumb li {
            position: relative;
        }

        .page-title .breadcrumb li:not(:last-child)::after {
            content: '/';
            margin-left: 10px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .header-search {
            position: relative;
        }

        .header-search input {
            width: 320px;
            padding: 12px 18px 12px 45px;
            border: 2px solid rgba(13, 74, 74, 0.1);
            border-radius: 30px;
            font-size: 14px;
            transition: var(--transition);
            background: rgba(248, 250, 252, 0.8);
        }

        .header-search input:focus {
            width: 380px;
            border-color: var(--gold-color);
            box-shadow: 0 0 0 4px rgba(201, 162, 39, 0.1), 0 4px 20px rgba(13, 74, 74, 0.1);
            outline: none;
            background: white;
        }

        .header-search i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-color);
            transition: var(--transition);
        }
        
        .header-search input:focus + i,
        .header-search:focus-within i {
            color: var(--gold-color);
        }

        /* Search Results Dropdown */
        .search-results-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            z-index: 1000;
            max-height: 400px;
            overflow-y: auto;
            display: none;
            margin-top: 5px;
        }

        .search-category {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .search-category:last-child {
            border-bottom: none;
        }

        .search-category-title {
            padding: 5px 15px;
            font-size: 12px;
            font-weight: 600;
            color: #666;
            text-transform: uppercase;
        }

        .search-category-title i {
            margin-right: 8px;
            color: var(--primary-color);
        }

        .search-item {
            padding: 10px 15px;
            cursor: pointer;
            transition: var(--transition);
        }

        .search-item:hover {
            background-color: rgba(13, 92, 99, 0.1);
        }

        .search-item strong {
            color: var(--primary-color);
        }

        .search-no-results {
            padding: 20px;
            text-align: center;
            color: #999;
        }

        .header-icons {
            display: flex;
            gap: 15px;
        }

        .header-icon {
            position: relative;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(13, 74, 74, 0.05) 0%, rgba(201, 162, 39, 0.05) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-color);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            border: 1px solid rgba(13, 74, 74, 0.1);
        }

        .header-icon:hover {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
            color: var(--gold-light);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(13, 74, 74, 0.25);
            border-color: transparent;
        }

        .header-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            background: linear-gradient(135deg, #c9a227 0%, #d4af37 100%);
            color: var(--primary-dark);
            font-size: 10px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(201, 162, 39, 0.4);
            border: 2px solid white;
        }

        .user-dropdown {
            position: relative;
        }

        .user-avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0d4a4a 0%, #14605f 50%, #c9a227 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid rgba(201, 162, 39, 0.5);
            box-shadow: 0 4px 15px rgba(13, 74, 74, 0.2);
        }

        .user-avatar:hover {
            transform: scale(1.08) rotate(2deg);
            box-shadow: 0 8px 25px rgba(201, 162, 39, 0.3);
            border-color: #c9a227;
        }

        .dropdown-menu {
            position: absolute;
            top: 100%;
            right: 0;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            border-radius: var(--border-radius);
            box-shadow: 0 20px 60px rgba(13, 74, 74, 0.15);
            min-width: 250px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: var(--transition);
            z-index: 1000;
        }

        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-header {
            padding: 20px;
            border-bottom: 1px solid #eee;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .dropdown-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d4a4a 0%, #c9a227 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 20px;
            border: 2px solid #c9a227;
        }

        .dropdown-user h6 {
            margin: 0;
            font-size: 16px;
        }

        .dropdown-user span {
            font-size: 12px;
            color: #666;
        }

        .dropdown-item {
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--dark-color);
            text-decoration: none;
            transition: var(--transition);
            border-bottom: 1px solid #f5f5f5;
            cursor: pointer;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
        }

        .dropdown-item:hover {
            background: #f8f9fa;
            color: var(--primary-color);
        }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-divider {
            height: 1px;
            background: #eee;
            margin: 10px 0;
        }

        /* Content Area - Luxury */
        .content-wrapper {
            padding: 35px 40px;
        }

        /* Dashboard Stats - Premium */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 35px;
        }

        .stat-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.85) 100%);
            backdrop-filter: blur(10px);
            border-radius: var(--border-radius-lg);
            padding: 28px 30px;
            box-shadow: 0 10px 40px rgba(13, 74, 74, 0.08);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(201, 162, 39, 0.1);
        }
        
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #0d4a4a 0%, #c9a227 50%, #0d4a4a 100%);
            opacity: 0;
            transition: var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(13, 74, 74, 0.15);
        }
        
        .stat-card:hover::before {
            opacity: 1;
        }

        .stat-icon {
            position: absolute;
            top: 25px;
            right: 25px;
            width: 65px;
            height: 65px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            background: linear-gradient(135deg, rgba(13, 74, 74, 0.1) 0%, rgba(201, 162, 39, 0.1) 100%);
            color: var(--primary-color);
            opacity: 1;
        }

        .stat-content h3 {
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 8px;
            color: var(--primary-dark);
            letter-spacing: -1px;
        }

        .stat-content p {
            color: #718096;
            margin: 0;
            font-weight: 500;
            font-size: 14px;
        }

        .stat-trend {
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 500;
        }

        .stat-trend.positive {
            color: #10b981;
        }

        .stat-trend.negative {
            color: #ef4444;
        }

        /* Charts - Luxury */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 25px;
            margin-bottom: 35px;
        }

        .chart-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.92) 100%);
            backdrop-filter: blur(10px);
            border-radius: var(--border-radius-lg);
            padding: 30px;
            box-shadow: 0 10px 40px rgba(13, 74, 74, 0.08);
            border: 1px solid rgba(201, 162, 39, 0.08);
            transition: var(--transition);
        }
        
        .chart-card:hover {
            box-shadow: 0 15px 50px rgba(13, 74, 74, 0.12);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(13, 74, 74, 0.08);
        }

        .chart-header h4 {
            font-size: 18px;
            font-weight: 700;
            margin: 0;
            color: var(--primary-dark);
        }

        .chart-actions {
            display: flex;
            gap: 10px;
        }

        .chart-action-btn {
            padding: 8px 16px;
            border: 1px solid rgba(13, 74, 74, 0.15);
            background: white;
            border-radius: 10px;
            font-size: 12px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 500;
        }

        .chart-action-btn:hover {
            border-color: var(--gold-color);
            color: var(--primary-color);
            background: rgba(201, 162, 39, 0.05);
        }

        .chart-canvas {
            width: 100%;
            height: 320px;
            position: relative;
        }

        /* Tables & Cards - Luxury */
        .card {
            border: none;
            border-radius: var(--border-radius-lg);
            box-shadow: 0 10px 40px rgba(13, 74, 74, 0.08);
            margin-bottom: 35px;
            background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.95) 100%);
            backdrop-filter: blur(10px);
            overflow: hidden;
            border: 1px solid rgba(201, 162, 39, 0.08);
            overflow: hidden;
        }

        .card-header {
            background: linear-gradient(135deg, rgba(13, 74, 74, 0.02) 0%, rgba(201, 162, 39, 0.03) 100%);
            border-bottom: 1px solid rgba(201, 162, 39, 0.15);
            padding: 22px 28px;
