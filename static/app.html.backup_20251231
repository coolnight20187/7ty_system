        // Toggle edit mode in agent detail modal
        function toggleAgentEditMode() {
            const viewElements = document.querySelectorAll('.agent-detail-modal .view-mode');
            const editElements = document.querySelectorAll('.agent-detail-modal .edit-mode');
            const toggleBtn = document.getElementById('toggleEditModeBtn');
            
            const isCurrentlyViewMode = viewElements[0]?.style.display !== 'none';
            
            viewElements.forEach(el => {
                el.style.display = isCurrentlyViewMode ? 'none' : '';
            });
            editElements.forEach(el => {
                el.style.display = isCurrentlyViewMode ? 'block' : 'none';
            });
            
            // Update toggle button
            if (toggleBtn) {
                if (isCurrentlyViewMode) {
                    toggleBtn.innerHTML = '<i class="fas fa-eye me-1"></i>Xem';
                    toggleBtn.classList.remove('btn-primary');
                    toggleBtn.classList.add('btn-secondary');
                } else {
                    toggleBtn.innerHTML = '<i class="fas fa-edit me-1"></i>Chỉnh sửa';
                    toggleBtn.classList.remove('btn-secondary');
                    toggleBtn.classList.add('btn-primary');
                }
            }
        }
        
        // Save agent from detail modal
        async function saveAgentFromDetailModal(form) {
            try {
                showLoading();
                const formData = new FormData(form);
                const agentId = formData.get('agent_id');
                
                // Check if there are any file uploads
                const cccdFront = formData.get('cccd_front');
                const cccdBack = formData.get('cccd_back');
                const storeImage1 = formData.get('store_image_1');
                const storeImage2 = formData.get('store_image_2');
                const storeImage3 = formData.get('store_image_3');
                
                const hasFiles = (cccdFront && cccdFront.size > 0) || 
                                 (cccdBack && cccdBack.size > 0) ||
                                 (storeImage1 && storeImage1.size > 0) ||
                                 (storeImage2 && storeImage2.size > 0) ||
                                 (storeImage3 && storeImage3.size > 0);
                
                // Remove agent_id from formData for PUT request
                formData.delete('agent_id');
                
                // Remove empty file inputs
                ['cccd_front', 'cccd_back', 'store_image_1', 'store_image_2', 'store_image_3'].forEach(key => {
                    const file = formData.get(key);
                    if (!file || file.size === 0) {
                        formData.delete(key);
                    }
                });
                
                let response;
                
                // Always use update-with-files endpoint for consistency
                response = await fetch(`${API_BASE_URL}/agents/${agentId}/update-with-files`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`
                    },
                    body: formData
                });

                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.detail || 'Không thể cập nhật đại lý');
                }

                hideLoading();
                showToast('Cập nhật đại lý thành công', 'success');
                loadAgents();
                
                // Reload the modal with updated data instead of closing
                viewAgent(agentId, false);
            } catch (error) {
                console.error('Error updating agent:', error);
                hideLoading();
                showToast(error.message || 'Không thể cập nhật đại lý', 'error');
            }
        }

