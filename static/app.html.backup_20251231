                                const backFormData = new FormData();
                                backFormData.append('file', cccdBackInput.files[0]);
                                backFormData.append('upload_type', 'cccd');
                                const backResp = await fetch(`${API_BASE_URL}/upload`, {
                                    method: 'POST',
                                    headers: { 'Authorization': `Bearer ${appState.token}` },
                                    body: backFormData
                                });
                                if (backResp.ok) {
                                    const backData = await backResp.json();
                                    cccdBackPath = backData.file_path || backData.path;
                                }
                            }
                        } catch (uploadError) {
                            console.error('CCCD upload error:', uploadError);
                        }
                    }
                    
                    const updateData = {};
                    if (formData.get('full_name')) updateData.full_name = formData.get('full_name');
                    if (formData.get('phone')) updateData.phone = formData.get('phone');
                    if (formData.get('email')) updateData.email = formData.get('email');
                    if (formData.get('address')) updateData.address = formData.get('address');
                    if (formData.get('new_password')) updateData.password = formData.get('new_password');
                    updateData.is_active = formData.get('is_active') === 'true';
                    
                    // Add CCCD paths if uploaded
                    if (cccdFrontPath) updateData.cccd_front_path = cccdFrontPath;
                    if (cccdBackPath) updateData.cccd_back_path = cccdBackPath;
                    
                    try {
                        const response = await fetch(`${API_BASE_URL}/customers/${customer.id}`, {
                            method: 'PUT',
                            headers: {
                                'Authorization': `Bearer ${appState.token}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(updateData)
                        });
                        
                        if (!response.ok) {
                            const error = await response.json();
                            throw new Error(error.detail || 'Cập nhật thất bại');
                        }
                        
                        showToast('Cập nhật khách hàng THẺ thành công', 'success');
                        loadCustomers();
                        return true;
                    } catch (error) {
                        Swal.showValidationMessage(error.message);
                        return false;
                    }
                }
            });
        }
        
