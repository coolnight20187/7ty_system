        function renderNotifications(notifications) {
            const container = document.getElementById('notificationList');
            if (!notifications || notifications.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-bell-slash fa-2x mb-2"></i>
                        <p>Không có thông báo mới</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = notifications.map(n => `
                <div class="notification-item ${n.is_read ? '' : 'unread'}" onclick="markNotificationRead(${n.id})">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-${getNotificationIcon(n.type)} me-3 text-primary"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">${n.title}</div>
                            <div class="text-muted small">${n.message}</div>
                            <div class="text-muted small mt-1">${formatRelativeTime(n.created_at)}</div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

