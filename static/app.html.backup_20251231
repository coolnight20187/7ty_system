        // Highlight form field with error based on error message
        function highlightFormError(form, errorMessage) {
            if (!form || !errorMessage) return;
            
            // Map error keywords to form field names
            const fieldMappings = {
                'điện thoại': 'phone',
                'phone': 'phone',
                'email': 'email',
                'mật khẩu': 'password',
                'password': 'password',
                'họ tên': 'full_name',
                'tên': 'full_name',
                'địa chỉ': 'address',
                'cccd': 'cccd_number',
                'cmnd': 'cccd_number'
            };
            
            const lowerMessage = errorMessage.toLowerCase();
            let targetField = null;
            
            // Find matching field
            for (const [keyword, fieldName] of Object.entries(fieldMappings)) {
                if (lowerMessage.includes(keyword)) {
                    targetField = form.querySelector(`[name="${fieldName}"]`) || 
                                  form.querySelector(`#agent${fieldName.charAt(0).toUpperCase() + fieldName.slice(1).replace(/_/g, '')}`);
                    break;
                }
            }
            
            if (targetField) {
                targetField.classList.add('is-invalid');
                targetField.focus();
                
                // Add error message below field
                let feedback = targetField.parentElement.querySelector('.invalid-feedback');
                if (!feedback) {
                    feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback';
                    targetField.parentElement.appendChild(feedback);
                }
                feedback.textContent = errorMessage;
                feedback.style.display = 'block';
            }
            
            // Also show error alert at top of form
            let alertEl = form.querySelector('.alert-danger.form-error-alert');
            if (!alertEl) {
                alertEl = document.createElement('div');
                alertEl.className = 'alert alert-danger form-error-alert d-flex align-items-center mb-3';
                alertEl.innerHTML = `<i class="fas fa-exclamation-triangle me-2"></i><span class="error-text"></span>`;
                form.insertBefore(alertEl, form.firstChild);
            }
            alertEl.querySelector('.error-text').textContent = errorMessage;
        }

