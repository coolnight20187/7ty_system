                updatePagination('customers', {
                    page: page,
                    total_pages: Math.ceil(total / limit)
                });
                hideLoading();
            } catch (error) {
                console.error('Error loading customers:', error);
                hideLoading();
                showToast('Không thể tải khách hàng THẺ', 'error');
            }
        }

        function renderCustomersTable(customers, page = 1, limit = 10) {
            const tbody = document.getElementById('customersTableBody');
            if (!tbody) return;
            if (customers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-5 text-muted"><i class="fas fa-id-card fa-2x mb-3"></i><p>Không có khách hàng THẺ nào</p></td></tr>';
                return;
            }
            
            const startIndex = (page - 1) * limit;
            
            tbody.innerHTML = customers.map((c, index) => `
                <tr>
                    <td class="text-center"><strong>${startIndex + index + 1}</strong></td>
                    <td><strong class="text-primary">${c.customer_code}</strong></td>
                    <td>${c.customer_name || c.full_name || 'N/A'}</td>
                    <td>
                        <span class="badge ${getCustomerTypeBadge(c.customer_type)}">
                            ${getCustomerTypeText(c.customer_type)}
                        </span>
                    </td>
                    <td>${c.phone || '<span class="text-muted">-</span>'}</td>
                    <td>${formatCustomerAddress(c)}</td>
                    <td>${c.agent?.agent_code || c.agent_id || '<span class="text-muted">-</span>'}</td>
                    <td>
                        <span class="status-badge ${c.status === 'active' ? 'status-active' : 'status-inactive'}">
                            ${c.status === 'active' ? 'Hoạt động' : 'Ngưng'}
                        </span>
                    </td>
                    <td>
                        <div class="actions">
                            <button class="action-btn" onclick="viewCustomer(${c.id})" data-tooltip="Xem chi tiết"><i class="fas fa-eye"></i></button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }
        
        function getCustomerTypeBadge(type) {
            switch(type) {
                case 'individual': return 'bg-info';
                case 'business': return 'bg-success';
                case 'organization': return 'bg-warning';
                default: return 'bg-secondary';
            }
        }
        
        function getCustomerTypeText(type) {
            switch(type) {
                case 'individual': return 'Cá nhân';
                case 'business': return 'Doanh nghiệp';
                case 'organization': return 'Tổ chức';
                default: return 'Khác';
            }
        }
        
        function formatCustomerAddress(c) {
            const parts = [];
            if (c.address) parts.push(c.address);
            if (c.ward) parts.push(c.ward);
            if (c.district) parts.push(c.district);
            if (c.city) parts.push(c.city);
            return parts.length > 0 ? parts.join(', ') : '<span class="text-muted">-</span>';
        }

        // Load users data
        async function loadUsers(page = 1) {
            try {
                showLoading();
                const limit = 10;
                const params = new URLSearchParams({ page: page, limit: limit });
                const response = await fetch(`${API_BASE_URL}/users?${params}`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                if (!response.ok) throw new Error('Không thể tải danh sách người dùng');
                const data = await response.json();
                const items = data.items || data || [];
                const total = data.total || items.length;
                renderUsersTable(items);
                
                // Update pagination
                updatePagination('users', {
                    page: page,
                    total_pages: Math.ceil(total / limit)
                });
                hideLoading();
            } catch (error) {
                console.error('Error loading users:', error);
                hideLoading();
            }
        }

        function renderUsersTable(users) {
            const tbody = document.getElementById('usersTableBody');
            if (!tbody) return;
            if (users.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted">Không có user</td></tr>';
