        async function saveDailyshopeeToken() {
            const cookie = document.getElementById('dsCookieInput')?.value.trim();
            const csrf = document.getElementById('dsCsrfInput')?.value.trim();
            const saveBtn = document.getElementById('dsSaveTokenBtn');
            const spinner = document.getElementById('dsSaveSpinner');
            const errorDiv = document.getElementById('dsTokenError');
            const successDiv = document.getElementById('dsTokenSuccess');
            
            // Validation
            if (!cookie) {
                errorDiv.textContent = 'Vui lòng nhập Cookie';
                errorDiv.classList.remove('d-none');
                successDiv.classList.add('d-none');
                return;
            }
            
            // Start loading
            saveBtn.disabled = true;
            spinner.classList.remove('d-none');
            errorDiv.classList.add('d-none');
            successDiv.classList.add('d-none');
            
            try {
                const response = await fetch(`${API_BASE_URL}/system/dailyshopee-save-cookie`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        cookie: cookie,
                        csrf_token: csrf || ''
                    })
                });
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                    successDiv.textContent = '✓ Cookie đã được lưu thành công!';
                    successDiv.classList.remove('d-none');
                    
                    updateDailyshopeeStatusUI(true, 'Đã kết nối');
                    updateConnectionStatus(true);
                    
                    showToast('Đã lưu Cookie DailyShopee!', 'success');
                    
                    // Close modal after 1.5s
                    setTimeout(() => {
                        hideModal('dailyshopeeLoginModal');
                        resetDsLoginModal();
                    }, 1500);
                } else {
                    throw new Error(result.detail || result.message || 'Lưu cookie thất bại');
                }
            } catch (error) {
                console.error('DS Save Cookie error:', error);
                errorDiv.textContent = error.message || 'Có lỗi xảy ra khi lưu cookie';
                errorDiv.classList.remove('d-none');
            } finally {
                saveBtn.disabled = false;
                spinner.classList.add('d-none');
            }
        }
        
