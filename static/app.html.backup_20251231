                    previewDiv.innerHTML = `
                        <img src="${e.target.result}" alt="Preview" style="max-width: 100%; max-height: 80px; border-radius: 8px; cursor: pointer;" onclick="showImagePreview('${e.target.result}', 'Ảnh đã chọn')">
