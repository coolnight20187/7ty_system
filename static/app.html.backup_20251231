    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        // API Configuration
        const API_BASE_URL = window.location.origin + '/api';
        const WS_BASE_URL = window.location.origin.replace('http', 'ws') + '/ws';

        // Check for token in URL (from login redirect)
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tokenFromUrl = urlParams.get('token');
            if (tokenFromUrl) {
                localStorage.setItem('token', tokenFromUrl);
                // Clean URL - remove token from URL for security
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        })();

        // Application State
        const appState = {
            currentPage: 'dashboard',
            currentUser: null,
            token: localStorage.getItem('token'),
            darkMode: localStorage.getItem('darkMode') === 'true',
            socket: null,
            isOnline: navigator.onLine,
            charts: {},
            currentFilters: {
                agents: {},
                bills: {},
                transactions: {}
            }
        };

        // Initialize application
        document.addEventListener('DOMContentLoaded', async function() {
            // Check authentication
            if (!appState.token) {
                redirectToLogin();
                return;
            }

            // Initialize UI
            await initUI();
            
            // Load initial data
            await loadInitialData();
            
            // Initialize WebSocket
            initWebSocket();
            
            // Setup event listeners
            setupEventListeners();
            
            // Hide loading screen
            setTimeout(() => {
                document.getElementById('loading-screen').style.opacity = '0';
                setTimeout(() => {
                    document.getElementById('loading-screen').style.display = 'none';
                }, 500);
            }, 1000);
        });

        // UI Initialization
        async function initUI() {
            // Apply dark mode
            if (appState.darkMode) {
                document.body.classList.add('dark-mode');
                document.getElementById('themeToggle').innerHTML = '<i class="fas fa-sun"></i>';
            }

            // Load user data
            await loadUserData();
            
            // Setup sidebar
            setupSidebar();
            
            // Setup modals
            setupModals();
            
            // Setup forms
            setupForms();
            
            // Setup charts
            setupCharts();
            
            // Setup network monitoring
            setupNetworkMonitoring();
        }

        // Load user data from API
        async function loadUserData() {
            try {
                const response = await fetch(`${API_BASE_URL}/users/me`, {
                    headers: {
                        'Authorization': `Bearer ${appState.token}`
                    }
                });

                if (response.status === 401) {
                    redirectToLogin();
                    return;
                }

                if (!response.ok) {
                    throw new Error('Không thể tải dữ liệu người dùng');
                }

                appState.currentUser = await response.json();
                
                // Update UI
                updateUserUI();
                
            } catch (error) {
                console.error('Error loading user data:', error);
                showToast('Không thể tải thông tin người dùng', 'error');
            }
        }

        // Update user UI elements
        function updateUserUI() {
            const user = appState.currentUser;
            if (!user) return;

            // Update avatar initials
            const initials = getInitials(user.full_name);
            document.getElementById('userInitials').textContent = initials;
            document.getElementById('dropdownUserInitials').textContent = initials;
            
            // Update user info
            document.getElementById('userFullName').textContent = user.full_name;
            document.getElementById('userRole').textContent = user.role || 'Người dùng';
            
            // Update profile page
            document.getElementById('profileName').textContent = user.full_name;
            document.getElementById('profileRole').textContent = user.role || 'Người dùng';
            document.getElementById('profileUsername').textContent = user.username;
            document.getElementById('profileEmail').textContent = user.email;
            document.getElementById('profilePhone').textContent = user.phone || 'Chưa cập nhật';
            document.getElementById('profileJoinDate').textContent = formatDate(user.created_at);
            
            // Update form fields
            document.getElementById('profileFullName').value = user.full_name;
            document.getElementById('profileFormEmail').value = user.email;
            document.getElementById('profileFormPhone').value = user.phone || '';
            document.getElementById('profileIdentity').value = user.identity_card || '';
            document.getElementById('profileAddress').value = user.address || '';
        }

        // Setup sidebar navigation
        function setupSidebar() {
            // Sidebar toggle
            document.getElementById('sidebarToggle').addEventListener('click', () => {
                document.getElementById('sidebar').classList.toggle('show');
            });

            // Menu item clicks
            document.querySelectorAll('.menu-item:not(.has-submenu)').forEach(item => {
                item.addEventListener('click', (e) => {
                    const page = e.currentTarget.dataset.page;
                    if (page) {
                        navigateTo(page);
                    }
                });
            });

            // Submenu toggles
            document.querySelectorAll('.menu-item.has-submenu').forEach(item => {
                item.addEventListener('click', (e) => {
                    const submenuId = e.currentTarget.dataset.submenu + 'Submenu';
                    const chevronId = e.currentTarget.dataset.submenu + 'Chevron';
                    
                    const submenu = document.getElementById(submenuId);
                    const chevron = document.getElementById(chevronId);
                    
                    submenu.classList.toggle('show');
                    chevron.classList.toggle('fa-chevron-down');
                    chevron.classList.toggle('fa-chevron-up');
                });
            });

            // Submenu item clicks
            document.querySelectorAll('.submenu-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    const page = e.currentTarget.dataset.page;
                    if (page) {
                        navigateTo(page);
                    }
                });
            });
        }

        // Navigation function
        function navigateTo(page) {
            // Hide all pages
            document.querySelectorAll('.page-content').forEach(p => {
                p.classList.remove('active');
            });

            // Update active menu items
            document.querySelectorAll('.menu-item, .submenu-item').forEach(item => {
                item.classList.remove('active');
            });

            // Show target page
            const targetPage = document.getElementById(page);
            if (targetPage) {
                targetPage.classList.add('active');
                appState.currentPage = page;
                
                // Update page title
                updatePageTitle(page);
                
                // Load page data
                loadPageData(page);
                
                // Close sidebar on mobile
                if (window.innerWidth < 1200) {
                    document.getElementById('sidebar').classList.remove('show');
                }
            }
        }

        // Update page title and breadcrumb
        function updatePageTitle(page) {
            const titles = {
                'dashboard': 'Dashboard',
                'agents': 'Quản lý Đại lý',
                'bills': 'Hóa đơn Điện',
                'transactions': 'Giao dịch',
                'customers': 'Quản lý Khách hàng THẺ',
                'profile': 'Thông tin cá nhân',
                'reports-sales': 'Báo cáo Doanh thu',
                'reports-agent': 'Báo cáo Đại lý',
                'reports-system': 'Báo cáo Hệ thống',
                'settings-system': 'Cài đặt Hệ thống',
                'settings-users': 'Quản lý Người dùng',
                'settings-security': 'Bảo mật',
                'settings-backup': 'Sao lưu & Khôi phục',
                'settings-proxy': 'Quản lý Proxy Pool'
            };

            const breadcrumbs = {
                'dashboard': ['Trang chủ'],
                'agents': ['Trang chủ', 'Đại lý'],
                'bills': ['Trang chủ', 'Hóa đơn'],
                'transactions': ['Trang chủ', 'Giao dịch'],
                'customers': ['Trang chủ', 'Khách hàng THẺ'],
                'profile': ['Trang chủ', 'Tài khoản'],
                'reports-sales': ['Trang chủ', 'Báo cáo', 'Doanh thu'],
                'reports-agent': ['Trang chủ', 'Báo cáo', 'Đại lý'],
                'reports-system': ['Trang chủ', 'Báo cáo', 'Hệ thống'],
                'settings-system': ['Trang chủ', 'Cài đặt', 'Hệ thống'],
                'settings-users': ['Trang chủ', 'Cài đặt', 'Người dùng'],
                'settings-security': ['Trang chủ', 'Cài đặt', 'Bảo mật'],
                'settings-backup': ['Trang chủ', 'Cài đặt', 'Sao lưu'],
                'settings-proxy': ['Trang chủ', 'Cài đặt', 'Proxy Pool']
            };

            document.getElementById('pageTitle').textContent = titles[page] || '7TY.VN';
            
            const breadcrumb = document.getElementById('breadcrumb');
            breadcrumb.innerHTML = (breadcrumbs[page] || ['Trang chủ']).map(item => 
                `<li>${item}</li>`
            ).join('');
        }

        // Load initial application data
        async function loadInitialData() {
            try {
                // Load dashboard data
                await loadDashboardData();
                
                // Load notifications count
                await loadNotificationsCount();
                
            } catch (error) {
                console.error('Error loading initial data:', error);
                showToast('Không thể tải dữ liệu ban đầu', 'error');
            }
        }

        // Load dashboard data
        async function loadDashboardData() {
            try {
                const response = await fetch(`${API_BASE_URL}/system/dashboard`, {
                    headers: {
                        'Authorization': `Bearer ${appState.token}`
                    }
                });

                if (!response.ok) throw new Error('Không thể tải dữ liệu bảng điều khiển');

