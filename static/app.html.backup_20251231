            const text = textarea.value.trim();
            
            if (!text) {
                showToast('Vui lòng nhập danh sách proxy', 'warning');
                return;
            }
            
            const proxies = text.split('\n').map(p => p.trim()).filter(p => p);
            
            if (proxies.length === 0) {
                showToast('Không có proxy hợp lệ', 'warning');
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE_URL}/system/proxy/add-batch`, {
                    method: 'POST',
                    headers: { 
                        'Authorization': `Bearer ${appState.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(proxies)
                });
                
                const result = await response.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    textarea.value = '';
                    loadProxyList();
                } else {
                    showToast(result.message, 'warning');
                }
            } catch (error) {
                console.error('Error adding batch proxies:', error);
                showToast('Lỗi khi thêm proxy', 'error');
            }
        }
        
        // Remove proxy
        async function removeProxy(proxyUrl) {
            if (!confirm('Xác nhận xóa proxy này?')) return;
            
            try {
                const response = await fetch(`${API_BASE_URL}/system/proxy/remove?proxy_url=${encodeURIComponent(proxyUrl)}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                const result = await response.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    loadProxyList();
                } else {
                    showToast(result.message, 'warning');
                }
            } catch (error) {
                console.error('Error removing proxy:', error);
                showToast('Lỗi khi xóa proxy', 'error');
            }
        }
        
