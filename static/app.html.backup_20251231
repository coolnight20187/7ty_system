        function startPollingForCallback() {
            if (dsPollingInterval) {
                clearInterval(dsPollingInterval);
            }
            
            // Poll every 2 seconds to check if bookmarklet sent cookies
            dsPollingInterval = setInterval(async () => {
                if (!dsSessionId) {
                    clearInterval(dsPollingInterval);
                    return;
                }
                
                try {
                    const response = await fetch(`${API_BASE_URL}/system/dailyshopee-check-session/${dsSessionId}`, {
                        headers: {
                            'Authorization': `Bearer ${appState.token}`
                        }
                    });
                    const result = await response.json();
                    
                    if (result.completed && result.success) {
                        // Success! Stop polling
                        clearInterval(dsPollingInterval);
                        dsPollingInterval = null;
                        
                        // Close popup if still open
                        if (dsLoginPopup && !dsLoginPopup.closed) {
                            dsLoginPopup.close();
                        }
                        dsLoginPopup = null;
                        
                        // Update UI
                        document.getElementById('dsPollingStatus')?.classList.add('d-none');
                        document.getElementById('dsAutoSuccess')?.classList.remove('d-none');
                        
                        updateDailyshopeeStatusUI(true, 'Đã kết nối');
                        showToast('✅ Token DailyShopee đã được cập nhật tự động!', 'success');
                        
                        // Close modal after 2 seconds
                        setTimeout(() => {
                            hideModal('dailyshopeeLoginModal');
                            resetDsLoginModal();
                        }, 2000);
                    }
                } catch (e) {
                    console.error('Polling error:', e);
                }
