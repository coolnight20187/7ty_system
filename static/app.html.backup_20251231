        function generateMockSalesReport(fromDate, toDate) {
            const days = [];
            const revenues = [];
            const start = fromDate ? new Date(fromDate) : new Date(Date.now() - 30*24*60*60*1000);
            const end = toDate ? new Date(toDate) : new Date();
            
            let totalRevenue = 0;
            let totalBills = 0;
            
            for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
                days.push(d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' }));
                const dayRevenue = Math.floor(Math.random() * 5000000) + 500000;
                revenues.push(dayRevenue);
                totalRevenue += dayRevenue;
                totalBills += Math.floor(Math.random() * 20) + 5;
            }
            
            return {
                total_revenue: totalRevenue,
                total_bills: totalBills,
                chart_data: { labels: days, values: revenues }
            };
        }

