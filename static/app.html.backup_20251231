        async function handleBulkLookup() {
            const textarea = document.getElementById('bulkLookupCodes');
            const provider = document.getElementById('bulkLookupProvider')?.value || 'evn_south';
            const gateway = document.getElementById('bulkApiGateway')?.value || 'dailyshopee';
            const btn = document.getElementById('bulkLookupBtn');
            const spinner = btn?.querySelector('.spinner-border');
            const loadingDiv = document.getElementById('bulkLookupLoading');
            const emptyDiv = document.getElementById('bulkLookupEmpty');
            const resultsDiv = document.getElementById('bulkLookupResults');
            const progressText = document.getElementById('bulkLookupProgress');
            
            if (!textarea) return;
            
            const codes = textarea.value.split('\n')
                .map(s => s.trim().toUpperCase())
                .filter(s => s.length >= 5);
            
            if (codes.length === 0) {
                showToast('Vui lòng nhập mã khách hàng để tra cứu', 'warning');
                return;
            }
            
            if (codes.length > 100) {
                showToast('Chỉ tra cứu tối đa 100 mã mỗi lần', 'warning');
                return;
            }
            
            // Start loading
            if (btn) btn.disabled = true;
            if (spinner) spinner.classList.remove('d-none');
            if (loadingDiv) loadingDiv.classList.remove('d-none');
            if (emptyDiv) emptyDiv.classList.add('d-none');
            if (resultsDiv) resultsDiv.classList.add('d-none');
            
            bulkLookupResults = [];
            
            // Stop flag for cancel button
            let stopLookup = false;
            
            // Setup stop button
            const stopBtn = document.getElementById('bulkStopBtn');
            if (stopBtn) {
                stopBtn.onclick = () => {
                    stopLookup = true;
                    showToast('⏹️ Đang dừng tra cứu...', 'warning');
                };
            }
            
            try {
                for (let i = 0; i < codes.length; i++) {
                    // Check if user clicked stop
                    if (stopLookup) {
                        showToast(`⏹️ Đã dừng tra cứu tại mã ${i}/${codes.length}`, 'info');
                        break;
                    }
                    
                    const code = codes[i];
                    
                    if (progressText) {
                        const gatewayLabel = gateway === 'fptshop' ? 'FPT Shop' : 'EVN';
                        progressText.textContent = `Đang tra cứu ${i + 1}/${codes.length}: ${code} (${gatewayLabel})...`;
                    }
                    
                    // Retry logic for server disconnected errors
                    const maxRetries = 3;
                    let retryCount = 0;
                    let lookupSuccess = false;
                    
                    while (retryCount < maxRetries && !lookupSuccess && !stopLookup) {
                        try {
                            const response = await fetch(`${API_BASE_URL}/bills/lookup`, {
                                method: 'POST',
                                headers: {
                                    'Authorization': `Bearer ${appState.token}`,
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    customer_code: code,
                                    provider: provider,
                                    gateway: gateway
                                })
                            });
                            
                            // Try to parse response - may throw error if server disconnected
                            let data;
                            try {
                                data = await response.json();
                            } catch (parseErr) {
                                // Server disconnected during response - retry
                                throw new Error('Server disconnected without sending a response');
                            }
                            
                            if (response.ok) {
                                // Check if hit rate limit - keep retrying with different proxy until success
                                if (data.error_code === 'RATE_LIMITED' || data.need_fallback) {
                                    showToast('⚠️ Bị giới hạn tốc độ - Đang thử lại với proxy khác...', 'warning');
                                    // Keep retrying - don't count towards max retries for rate limit
                                    if (progressText) {
                                        progressText.textContent = `🔄 Rate limit, đổi proxy và thử lại: ${code}...`;
                                    }
                                    // Wait longer before retry with different proxy
                                    await new Promise(r => setTimeout(r, 5000));
                                    continue;
                                }
                                
                                // Check if response contains server error - retry
                                const addressLower = (data.address || '').toLowerCase();
                                if (addressLower.includes('disconnect') || 
                                    addressLower.includes('server') ||
                                    addressLower.includes('lỗi kết nối') ||
                                    addressLower.includes('timeout')) {
                                    retryCount++;
                                    if (retryCount < maxRetries) {
                                        if (progressText) {
                                            progressText.textContent = `🔄 Server lỗi, thử lại lần ${retryCount}/${maxRetries}: ${code}...`;
                                        }
                                        showToast(`⚠️ Server lỗi mã ${code}, thử lại lần ${retryCount}...`, 'warning');
                                        await new Promise(r => setTimeout(r, 5000));
                                        continue;
                                    }
                                }
                                
                                bulkLookupResults.push({
                                    index: i + 1,
                                    code: code,
                                    name: data.customer_name || data.name || '-',
                                    address: data.address || '-',
                                    period: data.period || '-',
                                    amount: data.total_amount || data.amount || 0,
                                    source: data.source || gateway,
                                    status: data.success ? 'success' : 'error',
                                    raw: data
                                });
                                lookupSuccess = true;
                            } else {
                                bulkLookupResults.push({
                                    index: i + 1,
                                    code: code,
                                    name: data.customer_name || `(Mã ${code})`,
                                    address: data.address || data.detail || 'Không tìm thấy',
                                    period: '-',
                                    amount: 0,
                                    source: 'error',
                                    status: 'error',
                                    raw: data
                                });
                                lookupSuccess = true;
                            }
                        } catch (err) {
                            const errorMsg = err.message || 'Lỗi tra cứu';
                            const errorLower = errorMsg.toLowerCase();
                            // Check if server disconnected or network error - always retry
                            const isRetryableError = errorLower.includes('disconnect') || 
                                errorLower.includes('network') ||
                                errorLower.includes('failed to fetch') ||
                                errorLower.includes('connection') ||
                                errorLower.includes('server') ||
                                errorLower.includes('timeout') ||
                                errorLower.includes('abort') ||
                                errorLower.includes('response');
                            
                            // Always retry for any error
                            retryCount++;
                            if (retryCount < maxRetries) {
                                if (progressText) {
                                    progressText.textContent = `🔄 Lỗi kết nối, thử lại lần ${retryCount}/${maxRetries}: ${code}...`;
                                }
                                showToast(`⚠️ Lỗi "${errorMsg.substring(0, 50)}", thử lại mã ${code} lần ${retryCount}...`, 'warning');
                                // Wait 5 seconds before retry
                                await new Promise(r => setTimeout(r, 5000));
                                continue;
                            }
                            // Max retries reached
                            bulkLookupResults.push({
                                index: i + 1,
                                code: code,
                                name: `(Mã ${code})`,
                                address: `Lỗi sau ${maxRetries} lần thử: ${errorMsg}`,
                                period: '-',
                                amount: 0,
                                source: 'error',
                                status: 'error',
                                raw: null
                            });
                            lookupSuccess = true;
                        }
                    }
                    
                    // Render partial results
                    renderBulkResults();
                    
                    // Delay between requests: different for each gateway
                    if (i < codes.length - 1 && !stopLookup) {
                        const requestNum = i + 1;
                        
                        // Gateway 2 (fptshop): 7s delay, 21s pause after every 5 requests
                        // Gateway 1 (dailyshopee): 3s delay, no pause needed
                        const isGateway2 = gateway === 'fptshop';
                        
                        if (isGateway2 && requestNum % 5 === 0) {
                            // Gateway 2: Pause 21 seconds after every 5 requests
                            if (progressText) {
                                progressText.textContent = `⏸️ Tạm nghỉ 21 giây sau ${requestNum} request...`;
                            }
                            await new Promise(r => setTimeout(r, 21000));
                        } else {
                            // Normal delay: 7s for Gateway 2, 3s for Gateway 1
                            const normalDelay = isGateway2 ? 7000 : 3000;
                            await new Promise(r => setTimeout(r, normalDelay));
                        }
                    }
                }
                
                const successCount = bulkLookupResults.filter(r => r.status === 'success').length;
                showToast(`Đã tra cứu xong ${codes.length} mã (${successCount} thành công)`, 'success');
                
            } catch (error) {
                console.error('Bulk lookup error:', error);
                showToast('Có lỗi xảy ra khi tra cứu', 'error');
            } finally {
                if (btn) btn.disabled = false;
                if (spinner) spinner.classList.add('d-none');
                if (loadingDiv) loadingDiv.classList.add('d-none');
                if (resultsDiv) resultsDiv.classList.remove('d-none');
            }
        }
        
        function renderBulkResults() {
            const tbody = document.getElementById('bulkResultsBody');
            const resultsDiv = document.getElementById('bulkLookupResults');
            const emptyDiv = document.getElementById('bulkLookupEmpty');
            const countEl = document.getElementById('bulkResultsCount');
            const totalEl = document.getElementById('bulkTotalAmount');
            
            if (!tbody) return;
            
            // Filter results
            let filtered = bulkLookupResults;
            if (bulkHideZero) {
                filtered = bulkLookupResults.filter(r => r.amount > 0);
            }
            
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-muted">
                    <i class="fas fa-inbox fa-2x mb-2"></i><br>Không có kết quả
                </td></tr>`;
            } else {
                tbody.innerHTML = filtered.map((r, idx) => `
                    <tr class="${r.status === 'error' ? 'table-warning' : ''}" title="Nguồn: ${r.source || 'EVN'}">
                        <td><input type="checkbox" class="form-check-input bulk-select-item" data-index="${r.index - 1}" ${r.status === 'success' ? 'checked' : ''}></td>
                        <td>${idx + 1}</td>
                        <td><code class="text-primary">${r.code}</code></td>
