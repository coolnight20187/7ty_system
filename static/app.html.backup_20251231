        // Load bill history
        window.loadBillHistory = async function(page = 1) {
            const tbody = document.getElementById('billHistoryTableBody');
            if (!tbody) return;
            
            const fromDate = document.getElementById('historyFromDate').value;
            const toDate = document.getElementById('historyToDate').value;
            
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2">Đang tải lịch sử...</span>
                    </td>
                </tr>
            `;
            
            try {
                const params = new URLSearchParams({
                    skip: (page - 1) * 20,
                    limit: 20
                });
                if (fromDate) params.append('from_date', fromDate);
                if (toDate) params.append('to_date', toDate);
                
                const response = await fetch(`${API_BASE_URL}/bills/history?${params}`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                if (!response.ok) throw new Error('Không thể tải lịch sử');
                
                const data = await response.json();
                const items = data.items || data || [];
                
                if (items.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <i class="fas fa-history fa-2x text-muted mb-3"></i>
                                <p class="text-muted">Không có lịch sử trong khoảng thời gian này</p>
                            </td>
                        </tr>
                    `;
                    document.getElementById('historyCount').textContent = 'Không có dữ liệu';
                    return;
                }
                
                tbody.innerHTML = items.map((item, index) => `
                    <tr>
                        <td class="text-center">${(page - 1) * 20 + index + 1}</td>
                        <td>${formatDateTime(item.created_at)}</td>
                        <td><strong>${item.bill_code || 'N/A'}</strong></td>
                        <td>${item.customer_code || 'N/A'}</td>
                        <td>
                            <span class="badge ${getStatusBadgeClass(item.status || item.action)}">${item.status || item.action || 'N/A'}</span>
                        </td>
                        <td class="small">${item.details || item.description || '-'}</td>
                        <td>${item.user_name || item.created_by || 'System'}</td>
                        <td class="small text-muted">${item.ip_address || 'N/A'}</td>
                    </tr>
                `).join('');
                
                const total = data.total || items.length;
                document.getElementById('historyCount').textContent = `Hiển thị ${items.length} / ${total} bản ghi`;
                
            } catch (error) {
                console.error('Error loading bill history:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="text-center py-5 text-danger">
                            <i class="fas fa-exclamation-circle fa-2x mb-3"></i>
                            <p>Lỗi tải lịch sử: ${error.message}</p>
                        </td>
                    </tr>
                `;
            }
        };
        
        function getStatusBadgeClass(status) {
            if (!status) return 'bg-secondary';
            const statusLower = status.toLowerCase();
            if (statusLower.includes('trong kho') || statusLower.includes('in_stock') || statusLower.includes('tạo') || statusLower.includes('create') || statusLower.includes('add') || statusLower.includes('nhập')) return 'bg-success';
            if (statusLower.includes('sửa') || statusLower.includes('update') || statusLower.includes('edit')) return 'bg-warning text-dark';
            if (statusLower.includes('xóa') || statusLower.includes('delete') || statusLower.includes('remove')) return 'bg-danger';
            if (statusLower.includes('đã thanh toán') || statusLower.includes('thanh toán') || statusLower.includes('paid') || statusLower.includes('pay')) return 'bg-info';
            if (statusLower.includes('chờ xử lý') || statusLower.includes('pending')) return 'bg-warning text-dark';
            return 'bg-secondary';
        }
        
