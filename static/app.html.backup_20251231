                    params.append('sort_by', billsSortState.sortBy);
                    params.append('sort_order', billsSortState.sortOrder);
                }
                
                const response = await fetch(`${API_BASE_URL}/bills?${params}`, {
                    headers: {
                        'Authorization': `Bearer ${appState.token}`
                    }
                });

