        // Global search
        let searchTimeout;
        async function handleGlobalSearch(e) {
            const query = e.target.value.trim();
            clearTimeout(searchTimeout);
            
            if (query.length < 2) {
                hideSearchResults();
                return;
            }
            
            searchTimeout = setTimeout(async () => {
                try {
                    const results = await performGlobalSearch(query);
                    showSearchResults(results, query);
                } catch (error) {
                    console.error('Search error:', error);
                }
            }, 300);
        }

        async function performGlobalSearch(query) {
            const results = { agents: [], bills: [], customers: [], transactions: [] };
            
            try {
                // Search agents
                const agentsRes = await fetch(`${API_BASE_URL}/agents?search=${encodeURIComponent(query)}&limit=5`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                if (agentsRes.ok) {
                    const data = await agentsRes.json();
                    results.agents = data.items || data || [];
                }
            } catch (e) {}
            
            try {
                // Search bills
                const billsRes = await fetch(`${API_BASE_URL}/bills?search=${encodeURIComponent(query)}&limit=5`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                if (billsRes.ok) {
                    const data = await billsRes.json();
                    results.bills = data.items || data || [];
                }
            } catch (e) {}
            
            try {
                // Search customers
                const customersRes = await fetch(`${API_BASE_URL}/customers?search=${encodeURIComponent(query)}&limit=5`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                if (customersRes.ok) {
                    const data = await customersRes.json();
                    results.customers = data.items || data || [];
                }
            } catch (e) {}
            
            return results;
        }

