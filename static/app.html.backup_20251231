        // Create Customer
        async function createCustomer(form) {
            try {
                showLoading();
                const formData = new FormData(form);
                
                // Validate password match
                const password = formData.get('password');
                const confirmPassword = formData.get('confirm_password');
                
                if (password !== confirmPassword) {
                    hideLoading();
                    showToast('Mật khẩu xác nhận không khớp', 'error');
                    return;
                }
                
                if (password && password.length < 6) {
                    hideLoading();
                    showToast('Mật khẩu phải có ít nhất 6 ký tự', 'error');
                    return;
                }
                
                // Build JSON data (excluding file fields and confirm_password)
                const data = {};
                for (let [key, value] of formData.entries()) {
                    if (key !== 'cccd_front' && key !== 'cccd_back' && key !== 'confirm_password') {
                        if (value !== '') {
                            data[key] = value;
                        }
                    }
                }
                
                // Remove empty optional fields but keep required ones
                Object.keys(data).forEach(key => {
                    if (data[key] === '' && !['customer_code', 'customer_name', 'phone', 'password'].includes(key)) {
                        delete data[key];
                    }
                });
                
                const response = await fetch(`${API_BASE_URL}/customers`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                if (!response.ok) {
                    const error = await response.json();
                    // Handle validation error array
                    let errorMsg = 'Không thể tạo khách hàng THẺ';
                    if (error.detail) {
                        if (typeof error.detail === 'string') {
                            errorMsg = error.detail;
                        } else if (Array.isArray(error.detail)) {
                            errorMsg = error.detail.map(e => e.msg || e).join(', ');
                        }
                    }
                    throw new Error(errorMsg);
                }

                hideLoading();
                hideModal('addCustomerModal');
                form.reset();
                showToast('Tạo khách hàng THẺ thành công', 'success');
                if (appState.currentPage === 'customers') loadCustomers();
            } catch (error) {
                console.error('Error creating customer:', error);
                hideLoading();
                showToast(error.message || 'Không thể tạo khách hàng THẺ', 'error');
