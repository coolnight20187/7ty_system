                        <td class="small text-muted">${r.period || '-'}</td>
                        <td class="text-end ${r.amount > 0 ? 'text-danger fw-bold' : 'text-muted'}">${formatCurrency(r.amount)}</td>
                        <td>
                            ${r.status === 'success' 
                                ? '<span class="badge bg-success"><i class="fas fa-check"></i></span>' 
                                : '<span class="badge bg-warning" title="Lỗi tra cứu"><i class="fas fa-exclamation-triangle"></i></span>'}
                        </td>
                    </tr>
                `).join('');
            }
            
            // Update count
            if (countEl) {
                const successCount = bulkLookupResults.filter(r => r.status === 'success').length;
                countEl.textContent = `${filtered.length} kết quả (${successCount} thành công)`;
            }
            
            // Update total
            if (totalEl) {
                const total = filtered.reduce((sum, r) => sum + (r.amount || 0), 0);
                totalEl.textContent = formatCurrency(total);
            }
            
            // Show results div
            if (resultsDiv) resultsDiv.classList.remove('d-none');
            if (emptyDiv) emptyDiv.classList.add('d-none');
        }
        
        async function handleBulkImport() {
            const selectedBoxes = document.querySelectorAll('#bulkResultsBody input.bulk-select-item:checked');
            if (selectedBoxes.length === 0) {
                showToast('Vui lòng chọn ít nhất 1 hóa đơn để nhập kho', 'warning');
                return;
            }
            
            const selectedResults = [];
            selectedBoxes.forEach(cb => {
                const idx = parseInt(cb.dataset.index);
                if (bulkLookupResults[idx] && bulkLookupResults[idx].status === 'success') {
                    selectedResults.push(bulkLookupResults[idx]);
                }
            });
            
            if (selectedResults.length === 0) {
                showToast('Không có hóa đơn hợp lệ để nhập kho', 'warning');
                return;
            }
            
            const confirmResult = await Swal.fire({
                title: 'Xác nhận nhập kho',
                html: `Bạn có muốn nhập <strong>${selectedResults.length}</strong> hóa đơn vào kho?<br>
                       <span class="text-danger">Tổng tiền: ${formatCurrency(selectedResults.reduce((s, r) => s + r.amount, 0))}</span>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Nhập kho',
                cancelButtonText: 'Hủy'
            });
            
            if (!confirmResult.isConfirmed) return;
            
            try {
                showLoading();
                
                const billsToImport = selectedResults.map(r => ({
                    customer_code: r.code,
                    customer_name: r.name,
                    address: r.address,
                    total_amount: r.amount,
                    provider: document.getElementById('bulkLookupProvider')?.value || 'evn_south',
                    raw_data: r.raw
                }));
                
                const response = await fetch(`${API_BASE_URL}/bills/bulk-import`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ bills: billsToImport })
                });
                
                if (response.ok) {
                    const result = await response.json();
                    showToast(`Đã nhập ${result.imported || selectedResults.length} hóa đơn vào kho`, 'success');
                    // Refresh bills list
                    loadBills('in_stock');
                } else {
                    const error = await response.json().catch(() => ({}));
                    throw new Error(error.detail || 'Lỗi nhập kho');
                }
            } catch (error) {
                console.error('Import error:', error);
                showToast('Lỗi nhập kho: ' + error.message, 'error');
            } finally {
                hideLoading();
            }
        }
        
        function handleBulkExport() {
            if (bulkLookupResults.length === 0) {
                showToast('Không có dữ liệu để xuất', 'warning');
                return;
            }
            
            let filtered = bulkLookupResults;
            if (bulkHideZero) {
                filtered = bulkLookupResults.filter(r => r.amount > 0);
            }
            
            // Create CSV content
            const headers = ['STT', 'Mã KH', 'Tên khách hàng', 'Địa chỉ', 'Số tiền', 'Trạng thái'];
            const rows = filtered.map((r, idx) => [
                idx + 1,
                r.code,
                r.name,
                r.address,
                r.amount,
                r.status === 'success' ? 'Thành công' : 'Lỗi'
            ]);
            
            const csvContent = [headers, ...rows]
                .map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(','))
                .join('\n');
            
            const BOM = '\uFEFF';
            const blob = new Blob([BOM + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `tra_cuu_dien_${new Date().toISOString().split('T')[0]}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            
            showToast('Đã xuất file Excel/CSV', 'success');
        }
        
