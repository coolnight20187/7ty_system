        function updateBookmarkletHref() {
            const bookmarkletLink = document.getElementById('dsBookmarklet');
            if (!bookmarkletLink || !dsSessionId) return;
            
            const callbackUrl = `${window.location.origin}/api/system/dailyshopee-callback`;
            
            // Bookmarklet code: reads cookies, localStorage, and sends to callback
            // It captures: document.cookie, localStorage token, csrf_token, uid
            const bookmarkletCode = `javascript:(function(){
                try {
                    var cookie = document.cookie || '';
                    var ls = window.localStorage || {};
                    var token = ls.getItem ? ls.getItem('token') || '' : '';
                    var uid = ls.getItem ? ls.getItem('uid') || '' : '';
                    var csrf = ls.getItem ? ls.getItem('csrf_token') || ls.getItem('csrfToken') || ls.getItem('_csrf') || '' : '';
                    
                    /* Try to get from cookies if not in localStorage */
                    if (!token) {
                        var m = cookie.match(/token=([^;]+)/);
                        if (m) token = m[1];
                    }
                    if (!uid) {
                        var m = cookie.match(/uid=([^;]+)/);
                        if (m) uid = m[1];
                    }
                    
                    /* Build full cookie string with token */
                    var fullCookie = cookie;
                    if (token && cookie.indexOf('token=') === -1) {
                        fullCookie += '; token=' + token;
                    }
                    if (uid && cookie.indexOf('uid=') === -1) {
                        fullCookie += '; uid=' + uid;
                    }
                    
                    var sid = '${dsSessionId}';
                    var url = '${callbackUrl}';
                    
                    fetch(url, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            session_id: sid,
                            cookie: fullCookie,
                            token: token,
                            uid: uid,
                            csrf_token: csrf
                        })
                    }).then(function(r){ return r.json(); }).then(function(d){
                        if(d.success){
                            alert('✅ Token đã được gửi thành công!\\n\\nCookie: ' + (fullCookie ? 'Có' : 'Không') + '\\nToken: ' + (token ? 'Có' : 'Không') + '\\nUID: ' + (uid ? 'Có' : 'Không') + '\\n\\nCửa sổ sẽ tự đóng.');
                            window.close();
                        } else {
                            alert('❌ Lỗi: ' + (d.error || 'Unknown'));
                        }
                    }).catch(function(e){
                        alert('❌ Lỗi kết nối: ' + e.message);
                    });
                } catch(err) {
                    alert('❌ Lỗi: ' + err.message);
                }
            })();`;
            
            bookmarkletLink.href = bookmarkletCode.replace(/\s+/g, ' ');
        }
        
        async function openDailyshopeePopup() {
            // First, start a session
            const started = await startDailyshopeeSession();
            if (!started) {
                showToast('Không thể khởi tạo phiên đăng nhập', 'error');
                return;
            }
            
            const width = 600;
            const height = 700;
            const left = (window.screen.width - width) / 2;
            const top = (window.screen.height - height) / 2;
            
            const loginUrl = 'https://web.dailyshopee.vn/login';
            
            dsLoginPopup = window.open(
                loginUrl,
                'DailyShopeeLogin',
                `width=${width},height=${height},left=${left},top=${top},resizable=yes,scrollbars=yes`
            );
            
            // Show polling status
            document.getElementById('dsPollingStatus')?.classList.remove('d-none');
            document.getElementById('dsAutoSuccess')?.classList.add('d-none');
            
            // Start polling for callback
            startPollingForCallback();
            
