        // Initialize WebSocket connection
        function initWebSocket() {
            try {
                appState.socket = new WebSocket(`${WS_BASE_URL}?token=${appState.token}`);
                
                appState.socket.onopen = () => {
                    console.log('WebSocket connected');
                };
                
                appState.socket.onmessage = (event) => {
                    const data = JSON.parse(event.data);
                    handleWebSocketMessage(data);
                };
                
                appState.socket.onclose = () => {
                    console.log('WebSocket disconnected');
                    // Attempt to reconnect after 5 seconds
                    setTimeout(initWebSocket, 5000);
                };
                
                appState.socket.onerror = (error) => {
                    console.error('WebSocket error:', error);
                };
                
            } catch (error) {
                console.error('Không thể kết nối WebSocket:', error);
            }
        }

        // Handle WebSocket messages
        function handleWebSocketMessage(data) {
            switch(data.type) {
                case 'notification':
                    handleNewNotification(data.data);
                    break;
                case 'stats_update':
                    updateDashboardStats(data.data);
                    break;
                case 'agent_update':
                    if (appState.currentPage === 'agents') {
                        loadAgents();
                    }
                    break;
                case 'bill_update':
                    if (appState.currentPage === 'bills') {
                        loadBills();
                    }
                    break;
            }
        }

