                            Swal.close();
                            deleteCustomer(customer.id);
                        };
                        
                        buttonGroup.appendChild(deleteBtn);
                        footer.appendChild(buttonGroup);
                    }
                },
                preConfirm: async () => {
                    if (!isEditMode) {
                        // Switch to edit mode
                        Swal.close();
                        showCustomerDetailModal(customer, true);
                        return false;
                    }
                    
                    // Save changes
                    const form = document.getElementById('customerDetailForm');
                    const formData = new FormData(form);
                    
                    // Check for CCCD image uploads
                    const cccdFrontInput = document.getElementById('editCccdFront');
                    const cccdBackInput = document.getElementById('editCccdBack');
                    const hasCccdFront = cccdFrontInput && cccdFrontInput.files.length > 0;
                    const hasCccdBack = cccdBackInput && cccdBackInput.files.length > 0;
                    
                    // If there are CCCD images, upload them first
                    let cccdFrontPath = null;
                    let cccdBackPath = null;
                    
                    if (hasCccdFront || hasCccdBack) {
                        try {
                            if (hasCccdFront) {
