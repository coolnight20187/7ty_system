        // ==================== BILLS SORTING & SELECTION ====================
        function initBillsSorting() {
            // Select All checkbox
            document.getElementById('billsSelectAll')?.addEventListener('change', (e) => {
                const isChecked = e.target.checked;
                const checkboxes = document.querySelectorAll('#billsTableBody .bill-checkbox');
                checkboxes.forEach(cb => {
                    cb.checked = isChecked;
                    const billId = cb.dataset.billId;
                    if (isChecked) {
                        if (!selectedBillIds.includes(billId)) {
                            selectedBillIds.push(billId);
                        }
                    } else {
                        selectedBillIds = selectedBillIds.filter(id => id !== billId);
                    }
                });
                updateSelectedCount();
            });
            
            // Individual checkbox click (delegated)
            document.getElementById('billsTableBody')?.addEventListener('change', (e) => {
                if (e.target.classList.contains('bill-checkbox')) {
                    const billId = e.target.dataset.billId;
                    if (e.target.checked) {
                        if (!selectedBillIds.includes(billId)) {
                            selectedBillIds.push(billId);
                        }
                    } else {
                        selectedBillIds = selectedBillIds.filter(id => id !== billId);
                        document.getElementById('billsSelectAll').checked = false;
                    }
                    
                    // Check if all visible checkboxes are checked
                    const allCheckboxes = document.querySelectorAll('#billsTableBody .bill-checkbox');
                    const allChecked = Array.from(allCheckboxes).every(cb => cb.checked);
                    document.getElementById('billsSelectAll').checked = allChecked;
                    
                    updateSelectedCount();
                }
            });
            
            // Sortable column headers
            document.querySelectorAll('#billsTable th.sortable').forEach(th => {
                th.addEventListener('click', () => {
                    const sortBy = th.dataset.sort;
                    if (!sortBy) return;
                    
                    // Toggle direction
                    if (billsSortState.sortBy === sortBy) {
                        billsSortState.sortOrder = billsSortState.sortOrder === 'asc' ? 'desc' : 'asc';
                    } else {
                        billsSortState.sortBy = sortBy;
                        billsSortState.sortOrder = 'asc';
                    }
                    
                    // Update visual indicators
                    updateSortIndicators();
                    
                    // Reload data
                    const activeTab = document.querySelector('[data-bill-tab].active');
                    const status = activeTab?.dataset.billTab || 'in_stock';
                    if (status !== 'bulk_lookup') {
                        loadBills(status, 1);
                    }
                });
            });
        }
        
        function updateSortIndicators() {
            document.querySelectorAll('#billsTable th.sortable').forEach(th => {
                const sortBy = th.dataset.sort;
                const icon = th.querySelector('i');
                if (!icon) return;
                
                // Remove all sort classes
                icon.className = 'fas fa-sort ms-1 text-muted';
                
                if (sortBy === billsSortState.sortBy) {
                    if (billsSortState.sortOrder === 'asc') {
                        icon.className = 'fas fa-sort-up ms-1 text-primary';
                    } else {
                        icon.className = 'fas fa-sort-down ms-1 text-primary';
                    }
                }
            });
        }
        
