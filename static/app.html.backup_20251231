            }
            
            const total = results.agents.length + results.bills.length + results.customers.length;
            
            if (total === 0) {
                resultsContainer.innerHTML = `<div class="search-no-results">Không tìm thấy kết quả cho "${query}"</div>`;
                resultsContainer.style.display = 'block';
