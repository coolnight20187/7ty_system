        // Toggle proxy enabled
        async function toggleProxyEnabled(enabled) {
            try {
                const response = await fetch(`${API_BASE_URL}/system/proxy/enable?enabled=${enabled}`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                const result = await response.json();
                if (result.success) {
                    showToast(result.message, 'success');
                } else {
                    showToast(result.message, 'warning');
                    // Revert checkbox
                    document.getElementById('proxyEnabled').checked = !enabled;
                }
            } catch (error) {
                console.error('Error toggling proxy:', error);
                showToast('Lỗi khi thay đổi trạng thái proxy', 'error');
                document.getElementById('proxyEnabled').checked = !enabled;
            }
        }
        
        // Test proxy
        async function testAllProxies() {
            const resultCard = document.getElementById('proxyTestResultCard');
            const resultDiv = document.getElementById('proxyTestResult');
            const testBtn = document.getElementById('testAllProxyBtn');
            
            // Disable button during test
            if (testBtn) {
                testBtn.disabled = true;
                testBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang test...';
            }
            
            resultCard.classList.remove('d-none');
            resultDiv.innerHTML = `
                <div class="alert alert-info mb-2" id="proxyTestStatus">
                    <i class="fas fa-spinner fa-spin me-2"></i>
                    <span>Đang kết nối...</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">#</th>
                                <th>Proxy</th>
                                <th style="width:150px">Trạng thái</th>
                                <th style="width:120px">IP</th>
                            </tr>
                        </thead>
                        <tbody id="proxyTestResultsBody">
                        </tbody>
                    </table>
                </div>
            `;
            
            try {
                // Use EventSource for streaming results
                const eventSource = new EventSource(`${API_BASE_URL}/system/proxy/test-all-stream?token=${appState.token}`);
                
                eventSource.onmessage = function(event) {
                    const data = JSON.parse(event.data);
                    const statusDiv = document.getElementById('proxyTestStatus');
                    const tbody = document.getElementById('proxyTestResultsBody');
                    
                    if (data.type === 'start') {
                        statusDiv.innerHTML = `
                            <i class="fas fa-spinner fa-spin me-2"></i>
                            <span>Đang test ${data.total} proxy...</span>
                        `;
                    } else if (data.type === 'result') {
                        const r = data.data;
                        const row = document.createElement('tr');
                        row.className = r.success ? 'table-success' : 'table-danger';
                        row.innerHTML = `
                            <td>${r.index}</td>
                            <td><small>${escapeHtml(r.proxy)}</small></td>
                            <td>
                                ${r.success 
                                    ? '<span class="badge bg-success"><i class="fas fa-check"></i> OK - Giữ lại</span>' 
                                    : `<span class="badge bg-danger"><i class="fas fa-times"></i> Đã xóa</span>`}
                            </td>
                            <td><code>${r.public_ip || r.message || '-'}</code></td>
                        `;
                        tbody.appendChild(row);
                        
                        // Scroll to bottom
                        row.scrollIntoView({ behavior: 'smooth', block: 'end' });
                    } else if (data.type === 'done') {
                        statusDiv.className = 'alert alert-success mb-2';
                        statusDiv.innerHTML = `
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Hoàn tất!</strong> ${data.success_count} thành công, ${data.fail_count} thất bại.
                            Còn lại <strong>${data.remaining}</strong> proxy hoạt động.
                        `;
                        eventSource.close();
                        
                        // Re-enable button
                        if (testBtn) {
                            testBtn.disabled = false;
                            testBtn.innerHTML = '<i class="fas fa-vial"></i> Test Tất Cả Proxy';
                        }
                        
                        // Refresh proxy list
                        loadProxyList();
                    } else if (data.type === 'error') {
                        statusDiv.className = 'alert alert-danger mb-2';
                        statusDiv.innerHTML = `
                            <i class="fas fa-times-circle me-2"></i>
                            <strong>Lỗi:</strong> ${escapeHtml(data.message)}
                        `;
                        eventSource.close();
                        
                        if (testBtn) {
                            testBtn.disabled = false;
                            testBtn.innerHTML = '<i class="fas fa-vial"></i> Test Tất Cả Proxy';
                        }
                    }
                };
                
                eventSource.onerror = function(error) {
                    console.error('EventSource error:', error);
                    eventSource.close();
                    
                    // Fallback to non-streaming API
                    testAllProxiesFallback();
                };
                
            } catch (error) {
                console.error('Error testing proxies:', error);
                // Fallback to non-streaming API
                testAllProxiesFallback();
            }
        }
        
        // Fallback function for browsers that don't support SSE well
        async function testAllProxiesFallback() {
            const resultCard = document.getElementById('proxyTestResultCard');
            const resultDiv = document.getElementById('proxyTestResult');
            const testBtn = document.getElementById('testAllProxyBtn');
            
            resultDiv.innerHTML = '<div class="text-center"><div class="spinner-border spinner-border-sm"></div> Đang test (chế độ thường)...</div>';
            
            try {
                const response = await fetch(`${API_BASE_URL}/system/proxy/test-all`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                const result = await response.json();
                
                if (result.success && result.results) {
                    let html = `
                        <div class="alert alert-success mb-2">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>${result.message}</strong>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Proxy</th>
                                        <th>Trạng thái</th>
                                        <th>IP</th>
                                    </tr>
                                </thead>
                                <tbody>
                    `;
                    
                    result.results.forEach((r, idx) => {
                        html += `
                            <tr class="${r.success ? 'table-success' : 'table-danger'}">
                                <td>${idx + 1}</td>
                                <td><small>${escapeHtml(r.proxy)}</small></td>
                                <td>
                                    ${r.success 
                                        ? '<span class="badge bg-success"><i class="fas fa-check"></i> OK - Giữ lại</span>' 
                                        : `<span class="badge bg-danger"><i class="fas fa-times"></i> Đã xóa</span>`}
                                </td>
                                <td><code>${r.public_ip || r.message || '-'}</code></td>
                            </tr>
                        `;
                    });
                    
                    html += `
                                </tbody>
                            </table>
                        </div>
                    `;
                    
                    resultDiv.innerHTML = html;
                    loadProxyList();
                } else {
                    resultDiv.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-times-circle me-2"></i>
                            <strong>Test thất bại</strong><br>
                            <small>${escapeHtml(result.message)}</small>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error testing proxies:', error);
                resultDiv.innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Lỗi kết nối: ${escapeHtml(error.message)}
                    </div>
                `;
            }
            
            if (testBtn) {
                testBtn.disabled = false;
                testBtn.innerHTML = '<i class="fas fa-vial"></i> Test Tất Cả Proxy';
            }
        }
        
        // Initialize proxy page events
        function initProxyPageEvents() {
            // Refresh button
            document.getElementById('refreshProxyBtn')?.addEventListener('click', loadProxyList);
            
            // Test all button
            document.getElementById('testAllProxyBtn')?.addEventListener('click', testAllProxies);
            
            // Clear all button
            document.getElementById('clearAllProxyBtn')?.addEventListener('click', clearAllProxies);
            
            // Add single proxy
            document.getElementById('addSingleProxyBtn')?.addEventListener('click', addSingleProxy);
            document.getElementById('singleProxyInput')?.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') addSingleProxy();
            });
            
            // Add batch proxies
            document.getElementById('addBatchProxyBtn')?.addEventListener('click', addBatchProxies);
            
            // Toggle enabled
            document.getElementById('proxyEnabled')?.addEventListener('change', (e) => {
                toggleProxyEnabled(e.target.checked);
            });
        }

        // Save security settings
        async function saveSecuritySettings() {
            try {
                showLoading();
                
                const enable2FA = document.getElementById('enable2FA').checked;
                const enableIPWhitelist = document.getElementById('enableIPWhitelist').checked;
                
                const response = await fetch(`${API_BASE_URL}/system/security`, {
                    method: 'PUT',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        enable_2fa: enable2FA,
                        enable_ip_whitelist: enableIPWhitelist
                    })
                });
                
                hideLoading();
                
                if (!response.ok) {
                    showToast('Không thể lưu cài đặt bảo mật', 'error');
                    return;
                }
                
                showToast('Lưu cài đặt bảo mật thành công', 'success');
            } catch (error) {
                console.error('Error saving security settings:', error);
                hideLoading();
                showToast('Lỗi khi lưu cài đặt bảo mật', 'error');
            }
        }

        // Backup system
        async function createBackup() {
            try {
                showLoading();
                
                const response = await fetch(`${API_BASE_URL}/system/backup`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                if (!response.ok) throw new Error('Không thể tạo bản sao lưu');
                
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `backup_${new Date().toISOString().split('T')[0]}.zip`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                a.remove();
                
                hideLoading();
                showToast('Sao lưu thành công', 'success');
            } catch (error) {
                console.error('Error creating backup:', error);
                hideLoading();
                showToast('Không thể tạo bản sao lưu', 'error');
            }
        }

        // =====================================================
        // TRANSACTIONS FILTER
        // =====================================================

        async function loadTransactionsWithFilter(page = 1) {
            try {
                showLoading();
                const skip = (page - 1) * 10;
                
                const filterType = document.getElementById('transactionTypeFilter')?.value || '';
                const filterStatus = document.getElementById('transactionStatusFilter')?.value || '';
                const filterDate = document.getElementById('transactionDateFilter')?.value || '';
                
                const params = new URLSearchParams({ skip: skip, limit: 10 });
                if (filterType) params.append('type', filterType);
                if (filterStatus) params.append('status', filterStatus);
                if (filterDate) params.append('date', filterDate);
                
                const response = await fetch(`${API_BASE_URL}/transactions?${params}`, {
                    headers: { 'Authorization': `Bearer ${appState.token}` }
                });
                
                if (!response.ok) throw new Error('Không thể tải danh sách giao dịch');
                
                const data = await response.json();
                const items = data.items || data || [];
                const total = data.total || items.length;
                
                renderTransactionsTable(items);
                updatePagination('transactions', {
                    page: page,
                    total_pages: Math.ceil(total / 10)
                });
                
                hideLoading();
            } catch (error) {
                console.error('Error loading transactions:', error);
                hideLoading();
                showToast('Không thể tải giao dịch', 'error');
            }
        }

        function clearTransactionFilters() {
            document.getElementById('transactionTypeFilter').value = '';
            document.getElementById('transactionStatusFilter').value = '';
            document.getElementById('transactionDateFilter').value = '';
            loadTransactions();
        }

        // =====================================================
        // PAGE LOAD HANDLERS
        // =====================================================

        // Handle page-specific initialization when navigating
        function onPageLoad(page) {
            switch(page) {
                case 'reports-sales':
                    initReportsPage();
                    break;
                case 'reports-agent':
                    runAgentReport();
                    break;
                case 'reports-system':
                    runSystemReport();
                    break;
                case 'transactions':
                    loadTransactions();
                    break;
                case 'customers':
                    loadCustomers();
                    break;
                case 'settings-users':
                    loadUsers();
                    break;
            }
        }

        // Export to browser console for debugging
        console.log('7TY.VN Application initialized');
        console.log('API Base URL:', API_BASE_URL);
        console.log('WebSocket URL:', WS_BASE_URL);
        console.log('User:', appState.currentUser);
    </script>
