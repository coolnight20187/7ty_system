        async function createAgent(form) {
            try {
                // Validate password confirmation
                const password = document.getElementById('agentPassword').value;
                const confirmPassword = document.getElementById('agentConfirmPassword').value;
                
                if (password !== confirmPassword) {
                    showToast('Mật khẩu xác nhận không khớp', 'error');
                    document.getElementById('agentConfirmPassword').focus();
                    return;
                }
                
                // Clear previous form errors
                clearFormErrors(form);
                
                showLoading();
                
                const formData = new FormData(form);
                
                // Remove fields not needed by backend
                formData.delete('username'); // Backend uses phone as username
                
                const response = await fetch(`${API_BASE_URL}/agents/register`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${appState.token}`
                    },
                    body: formData
                });

                if (!response.ok) {
                    let errorMessage = 'Không thể tạo đại lý';
                    try {
                        const error = await response.json();
                        // Support both 'error' and 'detail' fields from backend
                        errorMessage = error.error || error.detail || errorMessage;
                    } catch (e) {
                        console.error('Error parsing response:', e);
                        errorMessage = `Lỗi server (${response.status}): ${response.statusText}`;
                    }
                    
                    // Highlight the field that caused the error
                    highlightFormError(form, errorMessage);
                    
                    hideLoading();
                    showToast(errorMessage, 'error');
                    return;
                }

                hideLoading();
                hideModal('addAgentModal');
                form.reset();
                clearAllImagePreviews();
                showToast('Đăng ký đại lý thành công! Chờ duyệt...', 'success');
                
                // Refresh agents list
                if (appState.currentPage === 'agents') {
                    loadAgents();
                }
                
            } catch (error) {
                console.error('Error creating agent:', error);
                hideLoading();
                // Show detailed error message
                const errorMsg = error.message || 'Không thể đăng ký đại lý';
                highlightFormError(form, errorMsg);
                showToast(errorMsg, 'error');
            }
        }
        
        // Image preview function
        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);
            if (!preview) return;
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
                    preview.classList.add('has-image');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.innerHTML = `<div class="image-preview-placeholder"><i class="fas fa-image"></i>Chọn ảnh</div>`;
                preview.classList.remove('has-image');
            }
        }
        
